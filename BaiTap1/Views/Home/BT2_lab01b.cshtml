@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Thao tác trên bảng với colspan và rowspan</title>
</head>
<body>
    <table border="1" cellpadding="5" cellspacing="5" width="400" height="400">
        <tr>
            <th>1</th>
            <th colspan="3">2 3 4</th>
            @*<th>3</th>
            <th>4</th>*@
            <th>5</th>
        </tr>
        <tr style="vertical-align:top; text-align:right">
            <td align="left" valign="bottom">6</td>
            <td>7</td>
            <td>8</td>
            <td rowspan="3" align="center" valign="middle">9 14 19</td>
            <td>10</td>
        </tr>

        <tr style="vertical-align:top; text-align:right">
            <td align="left" valign="bottom">11</td>
            <td>12</td>
            <td>13</td>
            @*<td>14</td>*@
            <td>15</td>
        </tr>
        <tr style="vertical-align:top; text-align:right">
            <td align="left" valign="bottom">16</td>
            <td>17</td>
            <td>18</td>
            <@*td>19</td>*@
            <td>20</td>
        </tr>
        <tr style="vertical-align:top; text-align:right">
            <td align="left" valign="bottom">21</td>
            <td>22</td>
            <td>23</td>
            <td>24</td>
            <td>25</td>
        </tr>
    </table>
</body>
</html>
